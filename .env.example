# Rails: mock (default) or real
QUORUM_VOICE=mock            # mock | gnani
QUORUM_PAYMENTS=mock         # mock | pinelabs

# Gnani — Agent Builder Platform API (https://docs.gnani.ai/Platform/platform-introduction)
GNANI_API_KEY=
GNANI_BOT_ID=
GNANI_ENV=development
QUORUM_PUBLIC_URL=https://<your-tunnel>   # so the agent's pre-call API can fetch hotel variables

# Pine Labs Online — UAT (free developer keys at https://dashboardv2.pluralonline.com/signup)
PINELABS_BASE=https://pluraluat.v2.pinepg.in
PINELABS_SUB_BASE=
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MERCHANT_ID=
PINELABS_CALLBACK_URL=https://<your-tunnel>/webhooks/pinelabs

# Gnani Speech APIs (Vachana) — the vach_ key: STT + TTS only. Not the agent/outbound-call API.
GNANI_SPEECH_KEY=
GNANI_CALL_BUDGET=40         # hard cap on billable speech calls per checkout; counter in .gnani_budget.json
