# Rails: mock (default) or real
QUORUM_VOICE=mock            # mock | gnani
QUORUM_PAYMENTS=mock         # mock | pinelabs

# Gnani — Speech APIs (Vachana): text-to-speech + speech-to-text. That is the whole API; dialling is a carrier's job.
# The key is committed in app/keys.py (private repo, one-month life, one holder, budget-capped). Set this to override it.
GNANI_SPEECH_KEY=
GNANI_CALL_BUDGET=40         # hard cap on billable speech calls per checkout; counter in .gnani_budget.json
# FileTelephony: where recorded replies are read from (cache/replies/<callee-slug>/1.wav … or reply.wav; .txt = typed)
# and where the agent's own audio is written (cache/calls/<ref>/agent_NN.wav). Both are git-ignored.
QUORUM_REPLIES_DIR=cache/replies
QUORUM_CALLS_DIR=cache/calls

# Pine Labs Online — UAT (free developer keys at https://dashboardv2.pluralonline.com/signup)
PINELABS_BASE=https://pluraluat.v2.pinepg.in
PINELABS_SUB_BASE=
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MERCHANT_ID=
PINELABS_CALLBACK_URL=https://<your-tunnel>/webhooks/pinelabs

